# Supabase PostgreSQL Database URL (Get from Supabase Dashboard -> Settings -> Database -> Connection String)
# Example: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your_supabase_password@db.your_supabase_ref.supabase.co:5432/postgres

# Optional: football-data.org API Key for extended data feed
FOOTBALL_DATA_API_KEY=

# Server Configuration
PORT=8000
